# Copy to ai-engine/.env (gitignored, never committed) and adjust. All vars
# use the AI_ENGINE_ prefix (see app/config.py's pydantic Settings).

# Production Simulator the investigation pipeline queries for evidence.
# Defaults to local docker-compose. For the EC2-hosted simulator
# (docs/19-aws-strategy.md Phase 3), set to http://<EC2 public IP>:8090 --
# see infra/aws/ec2/production-simulator.json for the instance id, and
# re-fetch the current IP with:
#   aws ec2 describe-instances --profile ic-ec2 --region ap-south-1 \
#     --instance-ids <instance_id> --query 'Reservations[0].Instances[0].PublicIpAddress'
AI_ENGINE_SIMULATOR_BASE_URL=http://127.0.0.1:8090

# Local model tier (docs/adr/ADR-009-local-model-strategy.md).
AI_ENGINE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_ENGINE_OLLAMA_DEFAULT_MODEL=llama3.2:1b

# External/reasoning tier -- not wired yet (docs/adr/ADR-010-api-cloud-model-strategy.md).
AI_ENGINE_OPENROUTER_API_KEY=
AI_ENGINE_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
